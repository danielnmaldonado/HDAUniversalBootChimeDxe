# Native macOS metadata and editor files
.DS_Store
._*
*.swp
*.swo
*~

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# EDK2 workspaces and generated objects
/edk2/
/Build/
/Conf/
